.env
# optional project-local wrangler install for the VM's direct dashboard deploy (deploy/README.md)
node_modules/
__pycache__/
*.pyc
.pytest_cache/
logs/*.jsonl
logs/*.log
logs/*.json
logs/*.csv
# closed-bar archive for the paper-trial parity check (logging.closed_bars_dir, docs/bot_bar_parity.md)
logs/daily_bars/
# scripts/reset_portfolio.py's dated archives (logs/archive/<UTC stamp>/trades.csv, audit_log.jsonl, ...) and
# the paper-trial runbook's 1h-era archive: top-level logs/*.csv / *.jsonl patterns above don't cover subdirectories
logs/archive/
# temp files of atomic temp-then-replace writes (bar_decisions.json.tmp, market_snapshot.json.tmp)
logs/*.tmp
*.egg-info/
.venv/
venv/
.DS_Store
KILL_SWITCH

# Phase 2.0 intraday dataset (docs/system-redesign-2026-10.md §5.4): 16 coins x ~2yr x 15m bars
# (plus resampled 1h/4h/1d derivatives), stored as parquet. Unlike strategy_pack_run/data(_long)
# (committed CSV), this is deliberately NOT committed -- large, regeneratable from
# fetch_coinbase_long.py + resample_ohlcv.py, backtest-only.
strategy_pack_run/data_15m/
strategy_pack_run/data_15m_raw/

# Phase 1d universe datasets (docs/p1d_universe_datasets.md): raw per-symbol OHLCV CSVs
# (~38MB: 658 Kraken 720-bar files + 308 Coinbase long-history files). Deliberately NOT committed
# (same precedent as data_15m above): regeneratable via fetch_kraken.py / fetch_coinbase_long.py.
# Committed instead: manifest.csv, data_sources.md, the calibration report and SHA256SUMS.txt, so a
# regenerated snapshot can be compared against the one the gate numbers were produced from.
strategy_pack_run/data_universe/raw_kraken/*.csv
!strategy_pack_run/data_universe/raw_kraken/manifest.csv
strategy_pack_run/data_universe/raw_long/*.csv

# Intraday P0 dataset (docs/intraday_data.md): raw 15m/1h Coinbase candles + fetch state, regeneratable via
# strategy_pack_run/fetch_intraday_p0.py. Committed instead: SHA256SUMS.txt and coverage_summary.json.
strategy_pack_run/data_intraday/15m/
strategy_pack_run/data_intraday/1h/
strategy_pack_run/data_intraday/_state/
strategy_pack_run/data_intraday/_kraken/

# Intraday P2 per-trade / rejected-signal logs (docs/intraday_prereg.md §7 item 13): gitignored, SHA-256 in
# strategy_pack_run/intraday_p2_results.json.
strategy_pack_run/intraday_p2_logs/
