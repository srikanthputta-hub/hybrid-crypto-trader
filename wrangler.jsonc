{
  // Static-assets-only Worker: no "main" script, just the web/ dashboard
  // served directly. See README.md "Dashboard" for the deploy flow.
  "name": "hybrid-crypto-trader",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./web"
  },
  // Cloudflare's Workers Builds pipeline deploys PR/non-production branches
  // with `wrangler preview`, which requires this block to exist (can be
  // empty) even though this project doesn't otherwise use named previews.
  "previews": {}
}
