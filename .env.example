# Copy this file to .env and fill in your own values. Never commit .env.

# --- Exchange API credentials (only needed for mode: live) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. Coinbase, KuCoin) also require a passphrase/password
EXCHANGE_API_PASSWORD=

# --- Claude / Anthropic (only needed if advisor.enabled: true in config.yaml) ---
ANTHROPIC_API_KEY=

# --- Telegram notifications (optional -- new signal / fill / close alerts).  ---
# --- Both must be set or neither fires. Create a bot via @BotFather, then    ---
# --- message it once and GET https://api.telegram.org/bot<TOKEN>/getUpdates ---
# --- to find your chat id.                                                  ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety interlock: live trading refuses to place real orders unless   ---
# --- this is set to the exact string YES-I-UNDERSTAND-THE-RISK, in        ---
# --- addition to config.yaml mode: live. Two separate switches on purpose.--
LIVE_TRADING_CONFIRM=

# --- Heartbeat monitor (optional -- only used by scripts/run_live.py).    ---
# --- Dead-man's-switch for the VM/process itself: pinged once per loop    ---
# --- iteration. If the VM crashes, loses power, or the process dies, this ---
# --- ping stops arriving and the monitoring service alerts you -- which   ---
# --- the bot's own Telegram alerts can't do, since they'd be dead too.    ---
# --- Get a ping URL free at https://healthchecks.io (see deploy/README.md ---
# --- for setup). Leave blank to disable.                                  ---
HEALTHCHECK_PING_URL=

# --- Dashboard push throttle (optional -- only used by scripts/run_live.py). ---
# --- Minutes between heartbeat pushes of web/data.json (each push triggers a ---
# --- Cloudflare build); a content change pushes immediately regardless.      ---
# --- Blank/garbage = 60; values below 5 are raised to 5. See deploy/README.md ---
HCT_DASHBOARD_PUSH_MINUTES=
