# Copy this file to .env and fill in your own values. Never commit .env.

# --- Exchange API credentials (only needed for mode: live) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (e.g. Coinbase, KuCoin) also require a passphrase/password
EXCHANGE_API_PASSWORD=

# --- Claude / Anthropic (only needed if advisor.enabled: true in config.yaml) ---
ANTHROPIC_API_KEY=

# --- Telegram notifications (optional -- new signal / fill / close alerts).  ---
# --- Both must be set or neither fires. Create a bot via @BotFather, then    ---
# --- message it once and GET https://api.telegram.org/bot<TOKEN>/getUpdates ---
# --- to find your chat id.                                                  ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Safety interlock: live trading refuses to place real orders unless   ---
# --- this is set to the exact string YES-I-UNDERSTAND-THE-RISK, in        ---
# --- addition to config.yaml mode: live. Two separate switches on purpose.--
LIVE_TRADING_CONFIRM=
